  "connections": [
    {
      "from": [
        "plant",
        "y"
      ],
      "to": [
        "vel",
        "u"
      ]
    },
    {
      "from": [
        "plant",
        "y"
      ],
      "to": [
        "alim",
        "u"
      ]
    },
    {
      "from": [
        "vel",
        "y"
      ],
      "to": [
        "controller",
        "velocidade"
      ]
    },
    {
      "from": [
        "alim",
        "y"
      ],
      "to": [
        "controller",
        "alimentacao"
      ]
    },
    {
      "from": [
        "controller",
        "u"
      ],
      "to": [
        "actuator",
        "u"
      ]
    },
    {
      "from": [
        "actuator",
        "y"
      ],
      "to": [
        "plant",
        "u"
      ]
    }
  ]
}
